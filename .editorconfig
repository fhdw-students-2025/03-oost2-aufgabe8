root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120
# IntelliJ: never collapse imports into wildcards (Checkstyle forbids them)
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
# IntelliJ: regular imports, blank line, static imports (matches CustomImportOrder in checkstyle.xml)
ij_java_imports_layout = *, |, $*

[*.xml]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
